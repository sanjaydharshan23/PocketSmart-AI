  4  function bindAuthForm(id,url,redirect){const f=document.getElementById(id);if(!f)return;f.addEventListener('submit',async e=>{e.preventDefault();const m=document.getElementById('form-message');m.textContent='';try{const body=Object.fromEntries(new FormData(f).entries());await api(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});m.className='message success';m.textContent='Success';setTimeout(()=>location.href=redirect,400)}catch(err){m.textContent=err.message}})}
  5: function bindPlanner(id,url,multipart=false){const f=document.getElementById(id);if(!f)return;f.addEventListener('submit',async e=>{e.preventDefault();const m=document.getElementById('form-message'),r=document.getElementById('results');m.textContent='Generating...';r.innerHTML='';try{let body;if(multipart){body=new FormData(f)}else{const raw=Object.fromEntries(new FormData(f).entries());if(url.includes('home')){raw.budget=Number(raw.budget);raw.rooms=raw.rooms?raw.rooms.split(',').map(x=>x.trim()).filter(Boolean):[];try{raw.quantities=raw.quantities?JSON.parse(raw.quantities):{}}catch{throw new Error('Quantities must be valid JSON')}}else{raw.budget=Number(raw.budget);raw.guests=Number(raw.guests)}}const data=await api(url,{method:'POST',...(multipart?{body}:{headers:{'Content-Type':'application/json'},body:JSON.stringify(raw)})});m.textContent='';renderResults(r,data)}catch(err){m.textContent=err.message}})}
  6  function renderResults(el,d){el.innerHTML=`<div class="result-head"><div><span class="tag">${d.ai_generated?'AI generated':'Fallback mode'}</span><h2>${escapeHtml(d.summary)}</h2></div><strong>Budget ₹${Number(d.budget).toLocaleString('en-IN')}</strong></div><div class="result-grid">${d.recommendations.map(x=>`<article class="recommendation"><span class="tag">${escapeHtml(x.category)} · ${escapeHtml(x.platform)}</span><h3>${escapeHtml(x.title)}</h3><p>${escapeHtml(x.description)}</p><p class="price">₹${Number(x.estimated_price).toLocaleString('en-IN')}</p><p>${escapeHtml(x.why)}</p><a href="${x.url}" target="_blank" rel="noopener">View search results ↗</a></article>`).join('')}</div><div class="form-card"><h3>Planning tips</h3><ul>${(d.tips||[]).map(x=>`<li>${escapeHtml(x)}</li>`).join('')}</ul></div>`}
